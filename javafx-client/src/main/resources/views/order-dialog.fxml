<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.delivery.fx.controller.OrderDialogController"
      styleClass="dialog-root" prefWidth="520">

    <Label fx:id="formTitle" styleClass="form-title"/>

    <GridPane styleClass="form-grid" vgap="12" hgap="10">
        <columnConstraints>
            <ColumnConstraints prefWidth="150"/>
            <ColumnConstraints prefWidth="330"/>
        </columnConstraints>

        <Label text="Клиент *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="clientComboBox" prefWidth="330" promptText="Выберите клиента из списка"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Адрес отправления *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="pickupField" promptText="Откуда забрать посылку"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Адрес доставки *" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="deliveryField" promptText="Куда доставить посылку"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Описание" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextArea fx:id="descriptionField" promptText="Необязательное описание" prefRowCount="2"
                  wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Вес, кг *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="weightField" promptText="например, 2.5"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Стоимость, руб. *" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" promptText="например, 450.00"
                   GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="* — обязательные поля. Клиент выбирается из списка, вводить ID вручную не нужно."
           styleClass="hint-label" wrapText="true"/>

    <HBox spacing="10" styleClass="dialog-buttons">
        <Button text="Сохранить" onAction="#onSave" styleClass="button-primary" defaultButton="true"/>
        <Button text="Отмена" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>
