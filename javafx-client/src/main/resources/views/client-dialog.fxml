<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.delivery.fx.controller.ClientDialogController"
      styleClass="dialog-root" prefWidth="480">

    <Label fx:id="formTitle" styleClass="form-title"/>

    <GridPane styleClass="form-grid" vgap="12" hgap="10">
        <columnConstraints>
            <ColumnConstraints prefWidth="120"/>
            <ColumnConstraints prefWidth="300"/>
        </columnConstraints>

        <Label text="ФИО *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" promptText="Иванов Иван Иванович"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Телефон *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="+7 900 000-00-00"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Email" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" promptText="необязательно"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Адрес *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextArea fx:id="addressField" promptText="Домашний адрес клиента" prefRowCount="2"
                  wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="* — обязательные поля. Телефон и email должны быть уникальными."
           styleClass="hint-label" wrapText="true"/>

    <HBox spacing="10" styleClass="dialog-buttons">
        <Button text="Сохранить" onAction="#onSave" styleClass="button-primary" defaultButton="true"/>
        <Button text="Отмена" onAction="#onCancel" cancelButton="true"/>
    </HBox>
</VBox>
