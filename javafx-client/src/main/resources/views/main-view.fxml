<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.delivery.fx.controller.MainController"
            prefWidth="1240" prefHeight="760">

    <top>
        <VBox styleClass="header">
            <Label text="Служба доставки" styleClass="app-title"/>
            <Label text="КР №2 · JavaFX · JDBC · PostgreSQL — настольное приложение" styleClass="app-subtitle"/>
        </VBox>
    </top>

    <center>
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE">
            <Tab text="Заказы" closable="false">
                <BorderPane>
                    <top>
                        <VBox styleClass="toolbar">
                            <HBox spacing="8" styleClass="toolbar-row">
                                <Label text="Поиск:" styleClass="toolbar-label"/>
                                <TextField fx:id="orderSearchField" promptText="клиент, телефон, адреса…"
                                           prefWidth="260" onAction="#onSearchOrders"/>
                                <Button text="Найти" onAction="#onSearchOrders"/>
                                <Button text="Сброс" onAction="#onRefreshOrders"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Статистика" onAction="#onShowStatistics" styleClass="button-primary"/>
                            </HBox>
                            <HBox spacing="8" styleClass="toolbar-row">
                                <Label text="Фильтры:" styleClass="toolbar-label"/>
                                <Label text="статус"/>
                                <ComboBox fx:id="orderStatusFilter" prefWidth="170"/>
                                <Label text="цена от"/>
                                <TextField fx:id="minPriceField" prefWidth="90" promptText="0"/>
                                <Label text="до"/>
                                <TextField fx:id="maxPriceField" prefWidth="90" promptText="∞"/>
                                <Button text="Применить фильтр" onAction="#onFilterOrders"/>
                                <Label text="Сортировка:" styleClass="toolbar-label"/>
                                <ComboBox fx:id="orderSortField" prefWidth="170"/>
                                <ComboBox fx:id="orderSortDirection" prefWidth="150"/>
                                <Button text="Сортировать" onAction="#onSortOrders"/>
                            </HBox>
                        </VBox>
                    </top>
                    <center>
                        <TableView fx:id="ordersTable" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="orderIdColumn" text="№" prefWidth="48" minWidth="48"/>
                                <TableColumn fx:id="orderClientColumn" text="Клиент" prefWidth="170"/>
                                <TableColumn fx:id="orderPickupColumn" text="Откуда" prefWidth="160"/>
                                <TableColumn fx:id="orderDeliveryColumn" text="Куда" prefWidth="160"/>
                                <TableColumn fx:id="orderWeightColumn" text="Вес" prefWidth="90"/>
                                <TableColumn fx:id="orderPriceColumn" text="Стоимость" prefWidth="110"/>
                                <TableColumn fx:id="orderCreatedColumn" text="Создан" prefWidth="135"/>
                                <TableColumn fx:id="orderStatusColumn" text="Статус" prefWidth="150"/>
                            </columns>
                            <placeholder>
                                <Label text="Заказы не найдены"/>
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                        </TableView>
                    </center>
                    <bottom>
                        <HBox spacing="8" styleClass="action-bar">
                            <Button text="Добавить" onAction="#onAddOrder" styleClass="button-primary"/>
                            <Button text="Редактировать" onAction="#onEditOrder"/>
                            <Button text="Удалить" onAction="#onDeleteOrder" styleClass="button-danger"/>
                            <Button text="Сменить статус" onAction="#onChangeOrderStatus"/>
                            <Button text="Просмотр" onAction="#onShowOrderDetails"/>
                            <Button text="Обновить" onAction="#onRefreshOrders"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Экспорт в CSV" onAction="#onExportOrders"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </Tab>

            <Tab text="Клиенты" closable="false">
                <BorderPane>
                    <top>
                        <HBox spacing="8" styleClass="toolbar">
                            <Label text="Поиск:" styleClass="toolbar-label"/>
                            <TextField fx:id="clientSearchField" promptText="ФИО, телефон, email…"
                                       prefWidth="280" onAction="#onSearchClients"/>
                            <Button text="Найти" onAction="#onSearchClients"/>
                            <Button text="Сброс" onAction="#onRefreshClients"/>
                        </HBox>
                    </top>
                    <center>
                        <TableView fx:id="clientsTable" styleClass="data-table">
                            <columns>
                                <TableColumn fx:id="clientIdColumn" text="№" prefWidth="48" minWidth="48"/>
                                <TableColumn fx:id="clientNameColumn" text="ФИО" prefWidth="220"/>
                                <TableColumn fx:id="clientPhoneColumn" text="Телефон" prefWidth="150"/>
                                <TableColumn fx:id="clientEmailColumn" text="Email" prefWidth="200"/>
                                <TableColumn fx:id="clientAddressColumn" text="Адрес" prefWidth="300"/>
                            </columns>
                            <placeholder>
                                <Label text="Клиенты не найдены"/>
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                            </columnResizePolicy>
                        </TableView>
                    </center>
                    <bottom>
                        <HBox spacing="8" styleClass="action-bar">
                            <Button text="Добавить" onAction="#onAddClient" styleClass="button-primary"/>
                            <Button text="Редактировать" onAction="#onEditClient"/>
                            <Button text="Удалить" onAction="#onDeleteClient" styleClass="button-danger"/>
                            <Button text="Обновить" onAction="#onRefreshClients"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="Экспорт в CSV" onAction="#onExportClients"/>
                        </HBox>
                    </bottom>
                </BorderPane>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <Label fx:id="statusBar" styleClass="status-bar"/>
    </bottom>
</BorderPane>
