# КР №1/КР №2 (консольное приложение и JavaFX-клиент, JDBC)
DB_URL=jdbc:postgresql://localhost:55432/delivery_db
DB_USER=postgres
DB_PASSWORD=postgres

# КР №3 (backend/docker-compose.yml)
POSTGRES_DB=delivery_kr3
POSTGRES_USER=delivery_app
POSTGRES_PASSWORD=укажите_свой_пароль
POSTGRES_PORT=55433

JWT_SECRET_BASE64=укажите_случайный_base64_секрет_от_32_байт
JWT_ISSUER=delivery-service
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_NAME=Администратор системы
BOOTSTRAP_ADMIN_PASSWORD=укажите_временный_пароль_администратора

CORS_ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
PERMANENT_DELETE_ENABLED=true
APP_PORT=8080
